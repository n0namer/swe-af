{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArchitectureComponent"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArchitectureDecision"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "components",
    "interfaces",
    "decisions",
    "dependencies"
  ],
  "$defs": {
    "ArchitectureComponent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "touches_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "responsibility"
      ]
    },
    "ArchitectureDecision": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale"
      ]
    }
  }
}